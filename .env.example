# ==============================================================================
# MIM PK Dimoro - Environment Variables Template
# ==============================================================================
# File ini adalah contoh/template. Jangan letakkan kredensial rahasia di sini.
# Gunakan script switcher untuk beralih antara Supabase Local dan Remote:
#   npm run env:local   -> Menyalin .env.local.supabase-local ke .env.local
#   npm run env:remote  -> Menyalin .env.local.supabase-remote ke .env.local
#   npm run env:status  -> Cek target Supabase yang sedang aktif di .env.local
# ==============================================================================

# Supabase REST endpoint URL (Lokal: http://127.0.0.1:54321 | Cloud: https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon Public Key (Aman diakses browser, terproteksi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Server-only, JANGAN berikan prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Base URL aplikasi untuk Auth redirect callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000
